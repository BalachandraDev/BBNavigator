{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
  },
  "AllowedHosts": "*",
  "Security": { "RequireHttps": true, "AiRequestsPerMinute": 15, "SecretsKey": "" },
  "Swagger": { "Enabled": false },
  "ConnectionStrings": { "SqlServer": "", "Postgres": "" },
  "Storage": { "RootPath": "" },
  "Upload": { "MaxBytes": 26214400 },
  "Analysis": { "WindowChars": 12000 },
  "Processing": { "MaxPages": 500, "OcrMinChars": 25, "OcrBatchPages": 50, "MaxAttempts": 3, "StaleJobMinutes": 15 },
  "Auth": { "Issuer": "flowmind", "Audience": "flowmind-api", "SigningKey": "", "TokenMinutes": 60, "PlatformAdminKey": "" },
  "AiProviders": {
    "MistralOcr": { "ApiKey": "", "Model": "mistral-ocr-latest", "DailyPageLimit": 0, "EstimatedCostPer1000PagesUsd": 0 },
    "Gemini":     { "ApiKey": "", "Model": "gemini-3.1-flash-lite", "DailyRequestLimit": 0, "DailyTokenLimit": 0, "RequestsPerMinute": 5, "MaxOutputTokens": 8192 },
    "Cloudflare": { "AccountId": "", "ApiToken": "", "Model": "@cf/baai/bge-m3", "DailyNeuronLimit": 0 },
    "Groq":       { "ApiKey": "", "Model": "openai/gpt-oss-20b", "DailyRequestLimit": 0, "DailyTokenLimit": 0, "RequestsPerMinute": 10 }
  }
}
